{
  "name": "claude-stoplight",
  "productName": "Clawd",
  "version": "1.3.20",
  "description": "A tiny desktop traffic light that shows what Claude Code is doing: green = idle, yellow = working, red = waiting on you.",
  "main": "main.js",
  "author": "Alex Yang",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "npm run icon && electron-builder --win \"-c.directories.output=%USERPROFILE%\\.claude-stoplight\\build\" && node scripts/copy-dist.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.alexyang.claude-stoplight",
    "productName": "Clawd",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "alexjyang618-cloud",
      "repo": "claude-stoplight"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Clawd Setup ${version}.exe"
    }
  }
}
